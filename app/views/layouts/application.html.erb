<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= display_meta_tags(default_meta_tags) %>
    <%= preload_link_tag asset_path('bg_floor.png'), as: :image %>
    <%= preload_link_tag asset_path('bg_light.png'), as: :image %>
    <%= preload_link_tag asset_path('bg_sea.png'), as: :image %>
    <%= yield :head %>
    <!-- <link rel="manifest" href="/manifest.json"> -->
    <%= favicon_link_tag('favicon.ico') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" type="text/css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kaisei+Opti&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4FMY0KJ85J"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-4FMY0KJ85J');
    </script>
  </head>

  <body>
    <div data-controller="loading">
      <!-- ローディング画面 -->
      <div data-loading-target="screen" class="loading-screen hidden">
        <div class="flex items-center justify-center">
          <%= image_tag "logo_01.png", class: "loading-logo", data: { loading_target: "logo" } %>
        </div>
      </div>
      <!-- メインコンテンツ -->
      <div data-loading-target="content" class="main-content show">
        <%= render 'shared/header' %>
        <%= yield %>
        <div class="bg-light"></div>
      </div>
    </div>
  </body>
</html>
