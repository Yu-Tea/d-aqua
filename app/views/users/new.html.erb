<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-8 w-full max-w-lg">
      <%= render 'shared/flash_message' %>
      <h1><%= t('.title') %></h1>
      <%= form_with model: @user do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <div class="mb-4">
          <%= f.label :name, class: "block text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
        <div class="mb-4">
          <%= f.label :email, class: "block text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
        <div class="mb-4">
          <%= f.label :password, class: "block text-gray-700 mb-1" %>
          <%= f.password_field :password, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
        <div class="mb-4">
          <%= f.label :password_confirmation, class: "block text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
        <%= f.submit class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
      <% end %>
      <div class='text-center'>
        <%= link_to t('.to_login_page'), login_path %>
      </div>
    </div>
  </div>
</div>