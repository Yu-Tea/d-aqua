<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-5 lg:px-24 w-full text-center">
      <h1><%= t('.title') %></h1>
      <p>アナタが見つけたイキモノの数：<%= @discovered_count %>/<%= @total_creatures_count %></p>
        <%= link_to root_path, class: "mt-2" do %>
          <i class="fa-solid fa-fish-fins"></i><span class="font-bold">アクアリウムに戻る</span>
        <% end %>
      <% if @books.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6 my-6">
          <% @books.each do |book| %>
            <%= render 'shared/creature_card', creature: book.creature %>
          <% end %>
        </div>
      <% else %>
        <p>まだ生き物を発見していません</p>
      <% end %>
      <%= paginate @books %>
    </div>
  </div>
</div>