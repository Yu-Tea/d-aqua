<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-8 lg:px-24 w-full text-center">
      <h1><%= t('.title') %></h1>
      <p>アナタが見つけたイキモノが記録されます。</p>
      <% if @books.present? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-8 my-10">
          <% @books.each do |book| %>
            <%= render 'shared/creature_card', creature: book.creature %>
          <% end %>
        </div>
      <% else %>
      <p>まだ生き物を発見していません</p>
      <% end %>
      <%= link_to "アクアリウム", root_path, class: "aqua-button" %>
    </div>
  </div>
</div>