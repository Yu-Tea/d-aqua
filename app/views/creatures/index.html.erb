<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-8 w-full max-w-lg">
      <h1><%= t('.title') %></h1>
      <p>生き物をソウゾウしてアクアリウムで泳がせよう。</p>
      <%= link_to "ソウゾウする", new_creature_path, class: "aqua-button" %>
      <br><br>
      <% if @creatures.present? %>
        <p>アナタがソウゾウした生き物の一覧です。</p>
        <div>
          <% @creatures.each do |creature| %>
            <div class="bg-white flex items-center mb-5 p-3 rounded-xl gap-1.5">
              <%= link_to creature_path(creature), class: "creture-button mr-1" do %>
                <div class="creature-preview">
                  <%= raw creature.svg_content %>
                </div>
              <% end %>
              <div class="flex-auto c-name-link">
                <%= link_to creature_path(creature), class: "creture-link text-xl sm:text-2xl flex-auto" do %>
                  <%= creature.name %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <p>図鑑ページ用のレイアウト</p>
        <div>
          <% @creatures.each do |creature| %>
            <div class="bg-white flex items-center mb-5 p-3 rounded-xl gap-1.5">
              <%= link_to creature_path(creature), class: "creture-button mr-1" do %>
                <div class="creature-preview">
                  <%= raw creature.svg_content %>
                </div>
              <% end %>
              <div class="flex-auto c-name-link mr-2">
                <%= link_to creature_path(creature), class: "creture-link text-xl sm:text-2xl flex-auto" do %>
                  <%= creature.name %>
                <% end %>
              </div>
              <%= link_to "#" do %>
                <i class="fa-regular fa-heart fa-xl"></i>
              <% end %>
              <%= link_to "#" do %>
                <i class="fa-regular fa-square-check fa-xl"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>