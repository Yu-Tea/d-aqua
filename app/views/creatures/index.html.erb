<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-8 lg:px-24 w-full text-center">
      <h1><%= t('.title') %></h1>
      <p>生き物をソウゾウしてアクアリウムで泳がせよう。</p>
      <%= link_to "ソウゾウする", new_creature_path, class: "aqua-button" %>
      <% if @creatures.present? %>
        <p>アナタがソウゾウした生き物の一覧です。</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-8 my-10">
          <% @creatures.each do |creature| %>
            <%= render 'shared/creature_card', creature: creature %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>