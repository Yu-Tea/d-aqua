<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-5 lg:px-24 w-full text-center">
      <h1><%= t('.title') %></h1>
      <p>イキモノをソウゾウして<%= link_to "アクアリウム", root_path, class: "font-bold" %>に解き放とう。</p>
      <%= link_to new_creature_path, class: "aqua-button mt-3" do %>
        <i class="fa-solid fa-pencil mr-1"></i><span>ソウゾウする</span>
      <% end %>
      <% if @creatures.present? %>
        <h2 class="text-2xl mt-5">アナタがソウゾウしたイキモノ</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6 my-6">
          <% @creatures.each do |creature| %>
            <%= render 'shared/creature_card', creature: creature %>
          <% end %>
        </div>
      <% end %>
      <%= paginate @creatures %>
    </div>
  </div>
</div>