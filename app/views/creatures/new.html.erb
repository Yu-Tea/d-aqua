<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="mx-auto px-8 w-full max-w-lg">
      <%= render 'shared/flash_message' %>
      <h1><%= t('.title') %></h1>

      <%= form_with model: @creature do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <div class="mb-4" data-controller="drawing">
          <p>生き物</p>
          <div class="draw-box">
            <svg data-drawing-target="canvas" width="300px" height="300px" viewBox="0 0 300 300"></svg>
          </div>
          <div>
            線の太さ:
            <input type="range" min="1" max="10" value="3" data-drawing-target="strokeWidth">
          </div>
      
          <%= f.hidden_field :svg_data, data: { drawing_target: "output" } %>
          <button type="button" data-action="click->drawing#undo">
            ↶ 1つ戻る
          </button>
          <button type="button" data-action="click->drawing#clear">
            🗑️ クリア
          </button>
        </div>

        <div class="mb-4">
          <%= f.label :name, class: "block text-gray-700 mb-1" %>
          <p>※最大10文字までです</p>
          <%= f.text_field :name, maxlength: 10, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
      
        <div class="mb-4">
          <%= f.label :description, class: "block text-gray-700 mb-1" %>
          <p>※最大200文字までです</p>
          <%= f.text_area :description, maxlength: 200, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
        </div>
      
        <div class="mb-4">
          <%= f.label :movement, class: "block text-gray-700 mb-1" %>
          <%= f.radio_button :movement, :swim, checked: true %>
          <%= f.label :swim %>
          <%= f.radio_button :movement, :float %>
          <%= f.label :float %>
          <%= f.radio_button :movement, :rest %>
          <%= f.label :rest %>
        </div>
      
        <div class="mb-4">
          <%= f.label :size, class: "block text-gray-700 mb-1" %>
          <%= f.radio_button :size, :small %>
          <%= f.label :small %>
          <%= f.radio_button :size, :medium, checked: true %>
          <%= f.label :medium %>
          <%= f.radio_button :size, :large %>
          <%= f.label :large %>
        </div>

        <%= f.submit "作成する", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
      <% end %>
    </div>
  </div>
</div>