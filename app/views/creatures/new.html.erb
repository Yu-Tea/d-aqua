<% content_for(:title, t('.title')) %>
<div class="container mx-auto h-screen">
  <div class="bg_subpage">
    <div class="text-center mx-5 sm:mx-20">
      <h1><%= t('.title') %></h1>
      <p>アナタだけのイキモノをソウゾウしてみよう。
      <br>ページ下に制作のヒントがあるから参考にしてね。</p>
      <%= form_with model: @creature do |f| %>
      <%= render 'shared/error_messages', object: f.object %>
      <div class="flex flex-col lg:flex-row justify-center gap-8 mt-8 mb-2">
        <div class="flex-shrink-0 w-full lg:w-auto" data-controller="drawing">
          <div class="font-bold main-color text-left mb-1">お絵かき</div>
          <div class="draw-box mb-2">
            <svg data-drawing-target="canvas" width="300px" height="300px" viewBox="0 0 300 300"></svg>
          </div>
          <div class="my-3">
            線の太さ:
            <input type="range" min="2" max="15" value="3" data-drawing-target="strokeWidth">
          </div>
      
          <%= f.hidden_field :svg_data, data: { drawing_target: "output" } %>
          <button type="button" class="white-button px-3 py-1" data-action="click->drawing#undo">
            <i class="fa-solid fa-circle-arrow-left"></i>1つ戻る
          </button>
          <button type="button" class="white-button px-3 py-1" data-action="click->drawing#clear">
            <i class="fa-solid fa-trash-can"></i>すべて消す
          </button>
        </div>
        <div class="text-left flex-1 min-w-0">
          <div class="mb-4">
          <div class="flex items-center gap-1.5 mb-1">
            <%= f.label :name, class: "block font-bold main-color" %>
            <span class=" text-gray-600 text-sm">※最大10文字</span>
          </div>
          <%= f.text_field :name, maxlength: 10, class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
          </div>

          <div class="mb-4">
          <div class="flex items-center gap-1.5 mb-1">
            <%= f.label :description, class: "block font-bold main-color" %>
            <span class=" text-gray-600 text-sm">※最大200文字</span>
          </div>
          <%= f.text_area :description, maxlength: 200, rows: "7", class: "appearance-none border rounded-md w-full py-2 px-4 text-gray-700 leading-tight focus:border-blue-400 focus:outline-none" %>
          </div>

          <div class="mb-4">
          <%= f.label :movement, class: "block font-bold main-color mb-1" %>
          <%= f.radio_button :movement, :swim, checked: true %>
          <%= f.label :swim %>
          <%= f.radio_button :movement, :float %>
          <%= f.label :float %>
          <%= f.radio_button :movement, :rest %>
          <%= f.label :rest %>
          </div>

          <div class="mb-4">
          <%= f.label :size, class: "block font-bold main-color mb-1" %>
          <%= f.radio_button :size, :small %>
          <%= f.label :small %>
          <%= f.radio_button :size, :medium, checked: true %>
          <%= f.label :medium %>
          <%= f.radio_button :size, :large %>
          <%= f.label :large %>
          </div>
        </div>
      </div>
      <button type="submit" class="aqua-button"><i class="fa-solid fa-pencil mr-1"></i>ソウゾウする</button>
      <% end %>
      <!-- 制作のヒント文章 -->
      <div class="mt-12 text-left border border-white px-5 sm:px-12 py-6 rounded-xl">
        <h2 class="text-2xl mb-4">制作のヒント</h2>
        <p class="mt-4 main-color"><i class="fa-regular fa-lightbulb mr-1"></i>線の太さ</p>
        アクアリウムではイキモノは縮小して表示されるので、線が細めの印象になります。特にサイズ「小」を選択する場合は、細い線だとかすれて見辛くなる可能性があるので、太めの線で描くことをオススメします。
        <p class="mt-4 main-color"><i class="fa-regular fa-lightbulb mr-1"></i>動き「すいすい」</p>
        海中を左右に泳ぎ回るモーションをします。進行方向に合わせるために、左向きで描いてください。
        <p class="mt-4 main-color"><i class="fa-regular fa-lightbulb mr-1"></i>動き「ぷかぷか」</p>
        海中をゆっくり漂うモーションをします。
        <p  class="mt-4 main-color"><i class="fa-regular fa-lightbulb mr-1"></i>動き「もぞもぞ」</p>
        海底でじっと停止して、たまに少しだけ揺れるモーションをします。
      </div>
    </div>
  </div>
</div>